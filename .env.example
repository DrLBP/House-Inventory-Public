# This file lists the NAMES of the settings the app needs. It never contains real values.
# Real values go in:
#   - Vercel dashboard -> Project -> Settings -> Environment Variables (live app)
#   - a file named .env.local on your computer (git ignores it)
#
# Settings starting with VITE_ are built into the app and visible in the browser,
# so ONLY non-secret values may start with VITE_.

# ---- Browser settings (not secret) ----
# Supabase -> Project Settings -> Data API (Project URL)
VITE_SUPABASE_URL=
# Supabase -> Project Settings -> API Keys -> "Publishable key" (starts with sb_publishable_)
VITE_SUPABASE_PUBLISHABLE_KEY=

# ---- Server-only SECRETS (used by the /api functions on Vercel) ----
# Google Cloud -> Google Auth Platform -> Clients -> your Web client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Supabase -> Project Settings -> API Keys -> Secret keys (starts with sb_secret_)
SUPABASE_SECRET_KEY=
# A long random password (40+ characters) from a password manager.
# Used to encrypt the Google key. If changed later, Google must be reconnected.
APP_SECRET=
# A long random password (40+ characters) from a password manager. Vercel sends it
# with the daily keep-alive run (api/keepalive.js) so nobody else can trigger it.
CRON_SECRET=
# Anthropic Console -> API Keys (starts with sk-ant-). Used only by the server for
# "Suggest details" and "Look up current price". Set a spending limit in the Console.
ANTHROPIC_API_KEY=
